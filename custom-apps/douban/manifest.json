{
  "sdkVersion": "1.0",
  "id": "nox.douban",
  "name": "豆瓣",
  "version": "0.3.3",
  "author": "Nox for Flora",
  "description": "仿真豆瓣：小组（搜小组、建小组、看帖回帖，路人豆友和 char 都会发帖，可以实名也可以匿名）+ 书影音（标记想看在看看过、打星写短评长评、char 的书影音和豆列、年度报告）。+ 私信（和 char、豆友私聊，char 偶尔会主动来找你）。广播、日记、同城后面几期上线。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "user.profile.read",
    "ai.generate",
    "ai.chat",
    "ai.generateImage",
    "media.pick",
    "memory.write",
    "ui.toast",
    "network.fetch"
  ],
  "network": {
    "allowedDomains": [
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com"
    ]
  }
}
