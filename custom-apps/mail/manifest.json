  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "user.profile.read",
    "ai.generate",
    "ai.chat",
    "ai.generateImage",
    "media.pick",
    "memory.write",
    "ui.toast"
  ]
}
