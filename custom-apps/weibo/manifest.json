{
  "sdkVersion": "1.0",
  "id": "nox.weibo",
  "name": "微博",
  "version": "0.9.12",
  "author": "Nox for Flora",
  "description": "仿真微博：刷首页、看评论楼中楼、发微博等角色和路人来互动、逛角色主页。按用户身份分开，角色会记得你们在微博上的互动。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "user.profile.read",
    "ai.generate",
    "ai.generateImage",
    "ai.chat",
    "media.pick",
    "memory.write",
    "ui.toast",
    "chat.sendCard",
    "chat.sendMessage"
  ],
  "resources": {
    "presets": [
      "presets.json"
    ]
  }
}
